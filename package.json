{
  "name": "chord-grpc",
  "version": "1.0.0",
  "description": "",
  "main": "app/node.ts",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "gen-certs": "bash scripts/gen-certs.sh",
    "cleanData": "node ./data/cleanData.ts",
    "server": "node ./app/node.ts",
    "debugPrimary": "node --nolazy --inspect-brk=9229 --watch ./app/node.ts -- --port 8440",
    "debugSecondary": "node --nolazy --inspect-brk=9230 --watch ./app/node.ts --port 8441 --knownPort 8440",
    "client": "node ./client/client.ts",
    "web": "node ./web/web.ts",
    "devServer": "node --watch ./app/node.ts",
    "devWeb": "node --watch ./web/web.ts",
    "copyVendor": "node ./scripts/copy-vendor.js",
    "postinstall": "node ./scripts/copy-vendor.js",
    "prepare": "is-ci || husky"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.8.1",
    "express": "^5.2.1",
    "minimist": "^1.2.8",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/minimist": "^1.2.5",
    "@types/xml2js": "^0.4.14",
    "husky": "^9.0.0",
    "is-ci": "^4.1.0",
    "lodash": "^4.18.1",
    "prettier": "^3.8.4",
    "pretty-quick": "^4.0.0",
    "typescript": "^6.0.3",
    "vis-network": "^10.1.0",
    "xml2js": "^0.6.0"
  }
}
