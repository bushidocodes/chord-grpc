{
  "name": "chord-grpc",
  "version": "1.0.0",
  "description": "",
  "main": "app/node.ts",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "gen-certs": "bash scripts/gen-certs.sh",
    "gen-proto-types": "node ./scripts/gen-proto-types.js",
    "cleanData": "node ./data/cleanData.ts",
    "server": "node ./app/node.ts",
    "debugPrimary": "node --nolazy --inspect-brk=9229 --watch ./app/node.ts -- --port 8440",
    "debugSecondary": "node --nolazy --inspect-brk=9230 --watch ./app/node.ts --port 8441 --knownPort 8440",
    "client": "node ./client/client.ts",
    "web": "node ./web/web.ts",
    "devServer": "node --watch ./app/node.ts",
    "devWeb": "node --watch ./web/web.ts",
    "copyVendor": "node ./scripts/copy-vendor.js",
    "postinstall": "node ./scripts/copy-vendor.js",
    "prepare": "is-ci || husky"
  },
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.8.1",
    "express": "^5.2.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/express": "^5.0.0",
    "fast-xml-parser": "^5.10.1",
    "husky": "^9.0.0",
    "is-ci": "^4.1.0",
    "typescript": "^7.0.2",
    "vis-network": "^10.1.0"
  }
}
